<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline NuGet config.

  The sandboxed shell cannot read %APPDATA%\NuGet\NuGet.Config, and this mod has
  no PackageReferences at all (it only references the game's own DLLs), so we
  clear every package source and restore offline.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
